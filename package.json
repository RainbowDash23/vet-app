{
  "name": "vet-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión veterinaria con historia clínica vinculada a llavero NFC",
  "scripts": {
    "dev:api": "pnpm --filter @vet-app/api start:dev",
    "build:api": "pnpm --filter @vet-app/api build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm --filter @vet-app/api prisma:generate",
    "dev:desktop": "pnpm --filter @vet-app/desktop dev",
    "build:desktop": "pnpm --filter @vet-app/desktop build",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @vet-app/shared-types build && pnpm --filter @vet-app/api exec tsc --noEmit && pnpm --filter @vet-app/desktop exec tsc --noEmit",
    "test": "pnpm --filter @vet-app/api test && pnpm --filter @vet-app/desktop test",
    "test:e2e": "pnpm --filter @vet-app/api test:e2e",
    "test:e2e:db": "pnpm --filter @vet-app/api test:e2e:db",
    "test:all": "pnpm test && pnpm test:e2e",
    "audit:security": "node --test apps/desktop/test/unit/security-audit.spec.ts"
  },
  "packageManager": "pnpm@11.15.1"
}
