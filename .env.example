# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE GESTIÓN VETERINARIA (VET-APP)
# ==============================================================================

# Credenciales de PostgreSQL para Docker Compose
POSTGRES_USER=vet_admin
POSTGRES_PASSWORD=vet_secure_password_123
POSTGRES_DB=vet_app_db
POSTGRES_PORT=5433

# URL de conexión a PostgreSQL (Prisma ORM y ejecución contra base de datos real)
DATABASE_URL="postgresql://vet_admin:vet_secure_password_123@localhost:5433/vet_app_db?schema=public"

# Bandera para forzar ejecución E2E contra PostgreSQL real
USE_REAL_DB=true

# Configuración del servidor Backend API (NestJS)
PORT=3000
NODE_ENV=development

# Configuración Criptográfica JWT
JWT_SECRET=vet_app_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=vet_app_super_secret_refresh_jwt_key_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
