# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE GESTIÓN VETERINARIA (VET-APP)
# ==============================================================================

# Credenciales de PostgreSQL para Docker Compose
POSTGRES_USER=vet_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vet_app_db
POSTGRES_PORT=5433

# URL de conexión a PostgreSQL (Prisma ORM y ejecución contra base de datos real)
DATABASE_URL="postgresql://vet_admin:change_me@localhost:5433/vet_app_db?schema=public"

# URL de conexión directa a PostgreSQL (utilizada por Prisma para migraciones; en entorno local es idéntica a DATABASE_URL)
DIRECT_URL="postgresql://vet_admin:change_me@localhost:5433/vet_app_db?schema=public"

# Bandera para forzar ejecución E2E contra PostgreSQL real
USE_REAL_DB=true

# Configuración del servidor Backend API (NestJS)
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
PUBLIC_BASE_URL="http://localhost:3000/p"

# Configuración Criptográfica JWT (mínimo 32 caracteres)
JWT_SECRET=change_me_super_secret_jwt_key_must_be_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_super_secret_refresh_jwt_key_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Subsistema de Notificaciones y Tareas Programadas
NOTIFICATIONS_CRON_ENABLED=false
MAIL_DRIVER=log

# Contraseña inicial para usuarios de prueba en seed (solo desarrollo, nunca usar en producción).
# Por defecto Password123! si no se especifica.
# SEED_DEFAULT_PASSWORD=Password123!

# Herramientas de desarrollo y simulación en Desktop (desactivadas por defecto)
# VITE_DEV_TOOLS=true

# Puerto serial para lector ESP32 (opcional, si no se define se autodetecta por VID/PID)
# SERIAL_PORT=COM3

# Configuración SMTP (requerida únicamente si MAIL_DRIVER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=change_me
SMTP_FROM="Vet App <notificaciones@example.com>"
SMTP_SECURE=false
