# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA DE GESTIÓN VETERINARIA (VET-APP)
# ==============================================================================

# Credenciales de PostgreSQL para Docker Compose
POSTGRES_USER=vet_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vet_app_db
POSTGRES_PORT=5433

# URL de conexión a PostgreSQL (Prisma ORM y ejecución contra base de datos real)
DATABASE_URL="postgresql://vet_admin:change_me@localhost:5433/vet_app_db?schema=public"

# Bandera para forzar ejecución E2E contra PostgreSQL real
USE_REAL_DB=true

# Configuración del servidor Backend API (NestJS)
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Configuración Criptográfica JWT (mínimo 32 caracteres)
JWT_SECRET=change_me_super_secret_jwt_key_must_be_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_super_secret_refresh_jwt_key_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
