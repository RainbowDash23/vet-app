{
  "name": "@vet-app/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente de escritorio para el sistema de gestión veterinaria (Electron + React + TS + Vite)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'),path=require('path');const src=path.join('dist-electron','electron');if(fs.existsSync(src)){fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join('dist-electron',f)))}\"",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "test": "node --experimental-strip-types --import ./test/loader.mjs --test test/**/*.spec.ts",
    "test:ui": "vitest run",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "@animateicons/react": "^0.12.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vet-app/shared-types": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "serialport": "13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@serialport/binding-mock": "10.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.13.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "jsdom": "30.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "3.2.7"
  }
}
