{
  "name": "@vet-app/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Cliente de escritorio para el sistema de gestión veterinaria (Electron + React + TS + Vite)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'),path=require('path');const src=path.join('dist-electron','electron');if(fs.existsSync(src)){fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join('dist-electron',f)))};if(fs.existsSync(path.join('electron','splash.html'))){fs.copyFileSync(path.join('electron','splash.html'),path.join('dist-electron','splash.html'))}\"",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:dist": "pnpm build && electron-builder --win",
    "test": "node --experimental-strip-types --import ./test/loader.mjs --test test/**/*.spec.ts",
    "test:ui": "vitest run",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vet-app/shared-types": "workspace:*",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "serialport": "13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serialport/binding-mock": "10.2.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
