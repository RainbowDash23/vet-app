{
  "name": "@vet-app/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente de escritorio para el sistema de gestión veterinaria (Electron + React + TS + Vite)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
