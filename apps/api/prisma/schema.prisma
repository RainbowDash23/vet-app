datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modelos preliminares para la conexión relacional
enum Role {
  ADMIN
  RECEPCION
  VETERINARIO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(RECEPCION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
