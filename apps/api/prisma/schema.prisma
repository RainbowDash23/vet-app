datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VET
  RECEPTION
}

enum PetSpecies {
  CANINE
  FELINE
  AVIAN
  EQUINE
  RODENT
  REPTILE
  OTHER
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum ReproductiveStatus {
  INTACT
  NEUTERED
  SPAYED
  UNKNOWN
}

enum TagStatus {
  ACTIVE
  INACTIVE
  LOST
  DAMAGED
}

enum VisitStatus {
  PENDING
  SCHEDULED
  CANCELLED
}

enum AccessAction {
  NFC_SCAN
  MANUAL_LOOKUP
  HISTORY_VIEW
  EMERGENCY_SCAN
}

enum GrantSource {
  NFC_TAP
  OWNER_SIGNATURE
  CLINIC_REFERRAL
  EMERGENCY_OVERRIDE
}

enum GrantScope {
  FULL_HISTORY
  VACCINES_ONLY
}

model Clinic {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  phone     String?
  email     String?
  address   String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users        User[]
  visits       Visit[]
  accessGrants AccessGrant[]
  accessLogs   AccessLog[]
  vaccinations Vaccination[]

  @@map("clinics")
}

model User {
  id            String    @id @default(uuid())
  email         String
  password      String
  name          String
  role          Role      @default(RECEPTION)
  clinicId      String
  licenseNumber String?
  phone         String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visits        Visit[]        @relation("VetVisits")
  accessLogs    AccessLog[]
  vaccinations  Vaccination[]
  attachments   Attachment[]
  refreshTokens RefreshToken[]
  visitNotes    VisitNote[]

  @@index([clinicId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Owner {
  id         String    @id @default(uuid())
  documentId String?
  name       String
  lastName   String
  email      String?
  phone      String
  address    String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pets Pet[]

  @@index([documentId])
  @@index([phone])
  @@index([lastName])
  @@map("owners")
}

model Pet {
  id                     String             @id @default(uuid())
  name                   String
  species                PetSpecies
  breed                  String?
  sex                    PetSex             @default(UNKNOWN)
  birthDate              DateTime?
  isApproximateBirthDate Boolean            @default(false)
  color                  String?
  reproductiveStatus     ReproductiveStatus @default(UNKNOWN)
  notes                  String?
  ownerId                String
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  owner        Owner         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tags         Tag[]
  visits       Visit[]
  vaccinations Vaccination[]
  attachments  Attachment[]
  accessLogs   AccessLog[]
  accessGrants AccessGrant[]

  @@index([ownerId])
  @@index([name])
  @@map("pets")
}

model Tag {
  id         String    @id @default(uuid())
  uid        String
  publicCode String    @unique @default(uuid())
  status     TagStatus @default(ACTIVE)
  petId      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pet Pet? @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([uid])
  @@index([publicCode])
  @@index([petId])
  @@map("tags")
}

model AccessGrant {
  id        String      @id @default(uuid())
  petId     String
  clinicId  String
  source    GrantSource @default(NFC_TAP)
  scope     GrantScope  @default(FULL_HISTORY)
  grantedAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([petId, clinicId, expiresAt])
  @@map("access_grants")
}

model AccessLog {
  id        String       @id @default(uuid())
  petId     String
  clinicId  String?
  userId    String?
  action    AccessAction @default(NFC_SCAN)
  ipAddress String?
  userAgent String?
  timestamp DateTime     @default(now())

  pet    Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([petId, timestamp])
  @@index([clinicId, timestamp])
  @@index([userId])
  @@map("access_logs")
}

model Visit {
  id                 String      @id @default(uuid())
  clinicId           String
  vetId              String
  petId              String
  reason             String
  notes              String?
  diagnosis          String?
  treatment          String?
  weight             Float?
  temperature        Float?
  heartRate          Int?
  respiratoryRate    Int?
  scheduledDate      DateTime
  durationMinutes    Int         @default(30)
  status             VisitStatus @default(PENDING)
  cancellationReason String?
  closedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  veterinarian User         @relation("VetVisits", fields: [vetId], references: [id], onDelete: Restrict)
  pet          Pet          @relation(fields: [petId], references: [id], onDelete: Restrict)
  attachments  Attachment[]
  notesHistory VisitNote[]

  @@index([clinicId, scheduledDate])
  @@index([petId])
  @@index([vetId])
  @@map("visits")
}

model VisitNote {
  id        String   @id @default(uuid())
  visitId   String
  vetId     String
  content   String
  createdAt DateTime @default(now())

  visit        Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  veterinarian User  @relation(fields: [vetId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([vetId])
  @@map("visit_notes")
}

model Vaccination {
  id          String    @id @default(uuid())
  petId       String
  clinicId    String?
  vetId       String?
  vaccineName String
  batchNumber String?
  appliedAt   DateTime  @default(now())
  nextDueDate DateTime?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pet          Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic       Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  veterinarian User?   @relation(fields: [vetId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([nextDueDate])
  @@index([clinicId])
  @@map("vaccinations")
}

model Attachment {
  id           String    @id @default(uuid())
  filename     String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  description  String?
  uploadedById String
  petId        String?
  visitId      String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  pet        Pet?   @relation(fields: [petId], references: [id], onDelete: Cascade)
  visit      Visit? @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([visitId])
  @@map("attachments")
}
