# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://vet_admin:vet_secure_password_123@localhost:5432/vet_app_db?schema=public

# Seguridad y Autenticación
JWT_SECRET=vet_app_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
