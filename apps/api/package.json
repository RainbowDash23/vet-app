{
  "name": "@vet-app/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API para el sistema de gestión veterinaria (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "node -r ts-node/register --test test/**/*.spec.ts",
    "test:e2e": "node -r ts-node/register --test test/**/*.e2e-spec.ts",
    "test:e2e:db": "node test/run-e2e-db.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "bootstrap:admin": "node -r ts-node/register src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^7.10.1",
    "@vet-app/shared-types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nodemailer": "10.4.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
